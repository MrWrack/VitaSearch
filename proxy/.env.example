PORT=8080
HTTPS_PORT=8443
HOST=0.0.0.0
# REQUIRED when HOST is reachable from your LAN. Generate a long random value.
VITASEARCH_API_KEY=replace_with_at_least_24_random_characters
ALLOW_PRIVATE_TARGETS=0
MAX_SESSIONS=6

# HTTPS: set both files to enable TLS on HTTPS_PORT.
TLS_CERT_FILE=/absolute/path/to/fullchain.pem
TLS_KEY_FILE=/absolute/path/to/privkey.pem
# Optional private CA chain if your certificate setup needs it.
TLS_CA_FILE=
REDIRECT_HTTP_TO_HTTPS=1

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_REDIRECT_URI=https://your-proxy-hostname.example:8443/spotify/callback
